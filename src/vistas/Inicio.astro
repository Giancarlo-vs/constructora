---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Estratos from '../components/Estratos.astro';
import Icono from '../components/Icono.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import LlamadoAccion from '../components/LlamadoAccion.astro';
import { empresa } from '../data/empresa';
import { idiomaActual, ruta, servicioEn, textos } from '../i18n/ui';

const idioma = idiomaActual(Astro.currentLocale);
const t = textos[idioma];
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const destacados = (await getCollection('proyectos', (p) => p.data.destacado))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);
---

<Layout>
  <!-- Portada -->
  <section class="contenedor grid items-center gap-12 pb-20 pt-12 sm:pt-20 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="eyebrow">{empresa.eslogan[idioma]}</p>
      <h1 class="mt-4 text-5xl font-bold leading-[1.02] sm:text-7xl">
        {t.inicio.titulo1} <span class="text-clay">{t.inicio.titulo2}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{t.inicio.texto(empresa.fundacion)}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={ruta(idioma, 'contacto')} class="btn btn-primary">{t.cotizar} <Icono nombre="flecha" class="size-4" /></a>
        <a href={ruta(idioma, 'servicios')} class="btn btn-ghost">{t.inicio.verServicios}</a>
      </div>
    </div>

    <div class="relative aspect-[4/3.4] overflow-hidden rounded-3xl bg-sand shadow-2xl shadow-ink/10 dark:shadow-black/40">
      <Estratos semilla="portada" sondeo class="h-full w-full" />
      <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-4 rounded-2xl bg-paper/90 px-5 py-3 text-sm backdrop-blur">
        <span class="font-semibold">{t.inicio.tarjeta}</span>
        <span class="text-muted">Apartadó, Antioquia</span>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="border-y border-ink/10 bg-sand/50">
    <dl class="contenedor grid grid-cols-2 gap-8 py-10 md:grid-cols-4">
      {
        empresa.cifras.map((c) => (
          <div>
            <dt class="sr-only">{c.etiqueta[idioma]}</dt>
            <dd class="font-display text-4xl font-bold text-ink">{c.valor}</dd>
            <dd class="mt-1 text-sm text-muted">{c.etiqueta[idioma]}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Servicios -->
  <section class="contenedor py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.menu.servicios}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-5xl">{t.inicio.serviciosTitulo}</h2>
      </div>
      <a href={ruta(idioma, 'servicios')} class="btn btn-ghost">{t.inicio.todosServicios}</a>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-ink/10 ring-1 ring-ink/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((s) => {
          const datos = servicioEn(s, idioma);
          return (
            <li class="group bg-paper p-8 transition-colors hover:bg-sand/60">
              <a href={`${ruta(idioma, 'servicios')}#${s.id}`} class="block">
                <span class="flex size-12 items-center justify-center rounded-xl bg-noche text-ochre transition-colors group-hover:bg-clay group-hover:text-sobre-clay">
                  <Icono nombre={datos.icono} />
                </span>
                <h3 class="mt-6 text-xl font-semibold">{datos.titulo}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{datos.resumen}</p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Proyectos destacados -->
  <section class="bg-sand/50 py-24">
    <div class="contenedor">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.menu.proyectos}</p>
          <h2 class="mt-3 text-3xl font-bold sm:text-5xl">{t.inicio.proyectosTitulo}</h2>
        </div>
        <a href={ruta(idioma, 'proyectos')} class="btn btn-ghost">{t.inicio.todasObras}</a>
      </div>
      <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {destacados.map((p) => <TarjetaProyecto proyecto={p} />)}
      </div>
    </div>
  </section>

  <LlamadoAccion />
</Layout>
