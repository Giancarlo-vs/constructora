---
import Layout from '../layouts/Layout.astro';
import Encabezado from '../components/Encabezado.astro';
import Estratos from '../components/Estratos.astro';
import LlamadoAccion from '../components/LlamadoAccion.astro';
import { empresa } from '../data/empresa';
import { idiomaActual, textos } from '../i18n/ui';

const idioma = idiomaActual(Astro.currentLocale);
const t = textos[idioma];
const n = t.nosotros;
---

<Layout titulo={t.menu.nosotros} descripcion={n.descripcion(empresa.nombre, empresa.fundacion)}>
  <Encabezado antetitulo={t.menu.nosotros} titulo={n.titulo} texto={n.texto(empresa.nombre, empresa.fundacion)} />

  <section class="contenedor grid items-center gap-12 pb-24 lg:grid-cols-2">
    <div class="aspect-4/3 overflow-hidden rounded-3xl bg-sand">
      <Estratos semilla="nosotros" class="h-full w-full" />
    </div>
    <div class="prose prose-lg prose-stone dark:prose-invert">
      {n.parrafos(empresa.fundacion).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="bg-noche py-24 text-claro">
    <div class="contenedor">
      <p class="eyebrow text-ochre!">{n.historiaAntetitulo}</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold sm:text-5xl">{n.historiaTitulo}</h2>
      <ol class="mt-14 grid gap-10 md:grid-cols-3">
        {
          n.historia(empresa.nombre).map((h) => (
            <li class="border-t border-claro/20 pt-6">
              <span class="font-display text-sm font-bold text-ochre">{h.hito}</span>
              <h3 class="mt-3 text-xl font-semibold">{h.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-claro/70">{h.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="contenedor py-20">
    <dl class="grid grid-cols-2 gap-8 md:grid-cols-4">
      {
        empresa.cifras.map((c) => (
          <div class="border-l-2 border-naranja pl-5">
            <dt class="sr-only">{c.etiqueta[idioma]}</dt>
            <dd class="font-display text-4xl font-bold">{c.valor}</dd>
            <dd class="mt-1 text-sm text-muted">{c.etiqueta[idioma]}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <LlamadoAccion />
</Layout>
