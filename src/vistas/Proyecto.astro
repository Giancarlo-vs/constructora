---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Portada from '../components/Portada.astro';
import Icono from '../components/Icono.astro';
import Parrafos from '../components/Parrafos.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import LlamadoAccion from '../components/LlamadoAccion.astro';
import { idiomaActual, proyectoEn, ruta, textos } from '../i18n/ui';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  todos: CollectionEntry<'proyectos'>[];
}
const { proyecto, todos } = Astro.props;
const idioma = idiomaActual(Astro.currentLocale);
const t = textos[idioma].proyectos;
const { titulo, resumen, categoria, nombreCategoria, ubicacion, anio, cliente, alcance, portada, galeria, descripcion } =
  proyectoEn(proyecto, idioma);
const { Content } = await render(proyecto);

const ficha = [
  { etiqueta: t.categoria, valor: nombreCategoria },
  ...(ubicacion ? [{ etiqueta: t.ubicacion, valor: ubicacion }] : []),
  ...(anio ? [{ etiqueta: t.anio, valor: String(anio) }] : []),
  ...(cliente ? [{ etiqueta: t.cliente, valor: cliente }] : []),
];

// Relacionados: primero los de la misma categoría, luego por orden del catálogo.
const relacionados = todos
  .filter((p) => p.id !== proyecto.id)
  .sort((a, b) => Number(b.data.categoria === categoria) - Number(a.data.categoria === categoria) || a.data.orden - b.data.orden)
  .slice(0, 3);
---

<Layout titulo={titulo} descripcion={resumen}>
  <article>
    <header class="contenedor pb-10 pt-12 sm:pt-16">
      <a href={ruta(idioma, 'proyectos')} class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-clay">
        <Icono nombre="flecha" class="size-4 rotate-180" /> {t.volver}
      </a>
      <p class="eyebrow mt-8">{nombreCategoria}</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-bold leading-[1.05] sm:text-6xl">{titulo}</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">{resumen}</p>
    </header>

    <div class="contenedor">
      <div class="aspect-2/1 overflow-hidden rounded-3xl bg-sand">
        <Portada imagen={portada} alt={titulo} semilla={proyecto.id} sizes="(min-width: 1152px) 1152px, 100vw" prioridad />
      </div>
    </div>

    <div class="contenedor grid gap-12 py-16 lg:grid-cols-[1fr_20rem]">
      <div class="prose prose-lg prose-stone dark:prose-invert max-w-none prose-headings:font-display prose-a:text-clay">
        {descripcion ? <Parrafos texto={descripcion} /> : <Content />}
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <dl class="divide-y divide-ink/10 rounded-2xl bg-sand/60 px-6">
          {
            ficha.map((f) => (
              <div class="flex justify-between gap-4 py-4 text-sm">
                <dt class="text-muted">{f.etiqueta}</dt>
                <dd class="text-right font-semibold">{f.valor}</dd>
              </div>
            ))
          }
        </dl>
        {
          alcance.length > 0 && (
            <div>
              <h2 class="eyebrow">{t.alcance}</h2>
              <ul class="mt-4 space-y-3 text-sm">
                {alcance.map((a) => (
                  <li class="flex gap-3">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-clay" />
                    {a}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      galeria.length > 0 && (
        <section class="contenedor pb-16">
          <h2 class="eyebrow">{t.galeria}</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {galeria.map((img, i) => (
              <a href={img.src} class="block aspect-4/3 overflow-hidden rounded-2xl bg-sand" target="_blank" rel="noopener">
                <Image
                  src={img}
                  alt={`${titulo} – ${t.foto} ${i + 1}`}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                />
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {
    relacionados.length > 0 && (
      <section class="border-t border-ink/10 bg-sand/50 py-20">
        <div class="contenedor">
          <h2 class="text-2xl font-bold sm:text-3xl">{t.otros}</h2>
          <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((p) => <TarjetaProyecto proyecto={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <LlamadoAccion />
</Layout>
