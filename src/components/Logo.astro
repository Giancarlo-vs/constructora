---
import { empresa } from '../data/empresa';
import { idiomaActual, ruta } from '../i18n/ui';
import logo from '../assets/logo.png';
import logoClaro from '../assets/logo-claro.png';

interface Props {
  // Versión para fondos oscuros siempre (pie de página).
  claro?: boolean;
}
const { claro = false } = Astro.props;
const idioma = idiomaActual(Astro.currentLocale);
const tamano = 'h-8 w-auto md:h-10';
---

<a href={ruta(idioma, 'inicio')} class="block" aria-label={`${empresa.nombre} – ${idioma === 'es' ? 'inicio' : 'home'}`}>
  {
    claro ? (
      <img src={logoClaro.src} width={logoClaro.width} height={logoClaro.height} alt="" class={tamano} />
    ) : (
      <>
        <img src={logo.src} width={logo.width} height={logo.height} alt="" class:list={[tamano, 'dark:hidden']} />
        <img src={logoClaro.src} width={logoClaro.width} height={logoClaro.height} alt="" class:list={[tamano, 'hidden dark:block']} />
      </>
    )
  }
</a>
