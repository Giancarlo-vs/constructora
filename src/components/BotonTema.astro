---
// Alterna entre modo claro y oscuro. La lógica (window.cambiarTema) vive en el Layout.
import { idiomaActual, textos } from '../i18n/ui';
const t = textos[idiomaActual(Astro.currentLocale)];
---

<button
  type="button"
  onclick="cambiarTema()"
  class="flex size-10 cursor-pointer items-center justify-center rounded-full text-ink/70 ring-1 ring-ink/15 transition-colors hover:bg-sand hover:text-ink"
  aria-label={t.tema}
  title={t.tema}
>
  <!-- Luna en modo claro, sol en modo oscuro -->
  <svg viewBox="0 0 24 24" class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
  </svg>
  <svg viewBox="0 0 24 24" class="hidden size-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>
