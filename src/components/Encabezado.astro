---
// Encabezado de página interior (título + entradilla).
interface Props {
  antetitulo: string;
  titulo: string;
  texto?: string;
}
const { antetitulo, titulo, texto } = Astro.props;
---

<section class="contenedor pb-12 pt-16 sm:pt-24">
  <p class="eyebrow">{antetitulo}</p>
  <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-[1.05] sm:text-6xl">{titulo}</h1>
  {texto && <p class="mt-6 max-w-2xl text-lg text-muted">{texto}</p>}
  <slot />
</section>
