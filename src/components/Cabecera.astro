---
import Logo from './Logo.astro';
import BotonTema from './BotonTema.astro';
import BotonIdioma from './BotonIdioma.astro';
import { idiomaActual, ruta, textos } from '../i18n/ui';

const idioma = idiomaActual(Astro.currentLocale);
const t = textos[idioma];
const enlaces = [
  { href: ruta(idioma, 'servicios'), texto: t.menu.servicios },
  { href: ruta(idioma, 'proyectos'), texto: t.menu.proyectos },
  { href: ruta(idioma, 'nosotros'), texto: t.menu.nosotros },
];
const contacto = ruta(idioma, 'contacto');
const actual = Astro.url.pathname.replace(/\/$/, '');
const activo = (href: string) => actual === href || actual.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/85 backdrop-blur-md">
  <div class="contenedor flex h-16 items-center justify-between">
    <Logo />

    <nav class="hidden items-center gap-6 text-sm font-medium md:flex" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            aria-current={activo(e.href) ? 'page' : undefined}
            class="text-ink/70 transition-colors hover:text-ink aria-[current=page]:text-clay"
          >
            {e.texto}
          </a>
        ))
      }
      <div class="flex items-center gap-2">
        <BotonIdioma />
        <BotonTema />
      </div>
      <a href={contacto} class="btn btn-primary">{t.cotizar}</a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <BotonIdioma />
      <BotonTema />
      <!-- Menú móvil sin JavaScript -->
      <details class="group relative">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full ring-1 ring-ink/15 [&::-webkit-details-marker]:hidden"
          aria-label={t.abrirMenu}
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 flex w-60 flex-col rounded-2xl bg-paper p-2 shadow-xl ring-1 ring-ink/10 dark:bg-sand"
          aria-label="Móvil"
        >
          {
            enlaces.map((e) => (
              <a href={e.href} class="rounded-xl px-4 py-3 font-medium hover:bg-sand dark:hover:bg-paper">
                {e.texto}
              </a>
            ))
          }
          <a href={contacto} class="btn btn-primary mt-2">{t.cotizar}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
